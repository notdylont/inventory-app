<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Module details</title>
  </head>
  <body>
    <%- include('../partials/navbar.ejs') %>
    <p><a href="/modules">Modules</a> > <strong><%= mod.name %></strong></p>
    <a href="/modules/<%= mod.id %>/edit">Edit</a>
    <form action="/modules/<%= mod.id %>/delete" method="POST">
      <button type="submit">Delete</button>
    </form>
    <a href="/resources/new?moduleId=<%= mod.id %>">Add a resource</a>
    <h3><%= mod.name %></h3>
    <p><%= mod.description %></p>
    <table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Quantity</th>
      <th>Unit</th>
      <th>Low Stock Threshold</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% resources.forEach((resource) => { %>
    <tr>
      <td><%= resource.name %></td>
      <td><%= resource.quantity %></td>
      <td><%= resource.unit %></td>
      <td><%= resource.low_stock_threshold %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
  </body>
</html>
