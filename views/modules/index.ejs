<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Station Alpha</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <%- include('../partials/navbar.ejs') %>
  <div class="page">
    <div class="page-header">
      <h1>Modules</h1>
    </div>
    <div class="modules-grid">
      <% modules.forEach((mod) => { %>
      <div class="module-card">
        <h3><%= mod.name %></h3>
        <p><%= mod.description %></p>
        <a href="/modules/<%= mod.id %>" class="view-link">View &rsaquo;</a>
      </div>
      <% }) %>
    </div>
  </div>
</body>
</html>