<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Station management</title>
  </head>
  <body>
    <%- include('../partials/navbar.ejs') %>
    <% modules.forEach((mod) => { %>
      <div>
        <h3><%= mod.name %> </h3>
        <p><%= mod.description %></p>
        <a href="/modules/<%= mod.id %>">View</a>
      </div>
   <% }) %>
  </body>
</html>
